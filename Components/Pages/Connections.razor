@page "/"
@page "/connections"
@using System.Threading
@inject ISessionVault SessionVault
@inject IDbConnectorRegistry Registry
@inject IToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Connections — db-manager</PageTitle>

<div class="d-flex flex-row justify-content-between align-items-center mb-3">
    <h3 class="h3 mb-0">Connections</h3>
</div>

@* ---------------- Unlocked: profiles + add/edit form ---------------- *@

<div class="row g-3">
        <div class="col-12 col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-hdd-network me-2"></i>Saved connections
                    </h5>
                    @if (SessionVault.Profiles.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">
                            No connections yet — add one on the right.
                        </p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var profile in SessionVault.Profiles)
                            {
                                <div class="list-group-item d-flex align-items-center gap-2">
                                    <i class="bi @EngineIcon(profile.EngineKey)" title="@EngineName(profile.EngineKey)"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@profile.Name</div>
                                        <div class="text-body-secondary small">@EngineName(profile.EngineKey)</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Open in SQL editor"
                                            @onclick="() => OpenInEditor(profile.Id)">
                                        <i class="bi bi-play"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit"
                                            @onclick="() => StartEdit(profile)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                            @onclick="() => DeleteProfile(profile)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <BackupRestore />

            <QueryLibraryBackup />
        </div>

        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-plus-circle me-2"></i>@(_editingId is null ? "Add connection" : "Edit connection")
                    </h5>

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" placeholder="Prod reporting" @bind="_profileName" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Engine</label>
                            <select class="form-select" value="@_form.EngineKey" @onchange="OnEngineChanged">
                                @foreach (var connector in Registry.Connectors)
                                {
                                    <option value="@connector.EngineKey">@connector.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (_form.EngineKey == "sqlite")
                    {
                        <div class="mb-2">
                            <label class="form-label">Database file</label>
                            <input type="text" class="form-control" placeholder="/path/to/database.db (created when missing)"
                                   @bind="_form.FilePath" />
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Host</label>
                                <input type="text" class="form-control" placeholder="192.168.1.120" @bind="_form.Host" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Port</label>
                                <input type="text" class="form-control" placeholder="@SelectedConnector?.DefaultPort"
                                       @bind="_portText" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Database</label>
                                @if (_serverDatabases is null)
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="_form.Database" />
                                        <button type="button" class="btn btn-outline-secondary"
                                                title="Load the database list from the server"
                                                disabled="@_loadingDbs" @onclick="LoadDatabasesAsync">
                                            <i class="bi bi-list-ul"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <select class="form-select" @bind="_form.Database">
                                        <option value="">(none — pick later)</option>
                                        @foreach (var db in _serverDatabases)
                                        {
                                            <option value="@db">@db</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">User</label>
                                <input type="text" class="form-control" autocomplete="off" @bind="_form.Username" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" @bind="_form.Password" />
                            </div>
                        </div>

                        @if (_form.EngineKey == "mssql")
                        {
                            <div class="mb-2">
                                <label class="form-label">Encryption</label>
                                <select class="form-select" @bind="_form.EncryptMode">
                                    <option value="@SqlServerEncryption.TrustServerCertificate">On — trust self-signed certificate (default)</option>
                                    <option value="@SqlServerEncryption.VerifyCertificate">On — verify certificate chain</option>
                                    <option value="@SqlServerEncryption.Strict">Strict (TDS 8.0)</option>
                                    <option value="@SqlServerEncryption.Off">Off — no TLS (legacy servers)</option>
                                </select>
                                <div class="form-text">
                                    Pick "Off" when an old server rejects the TLS handshake; pick "verify"/"Strict" when the
                                    server requires a validated certificate.
                                </div>
                            </div>
                        }
                    }

                    @if (!_form.UseRaw && SelectedConnector?.SupportsServerLevel == true)
                    {
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="serverLevel" @bind="_form.IsServerLevel" />
                            <label class="form-check-label" for="serverLevel">
                                Connect to the whole server (pick a database later, SSMS-style)
                            </label>
                        </div>
                    }

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="useRaw" @bind="_form.UseRaw" />
                        <label class="form-check-label" for="useRaw">Use a raw connection string instead</label>
                    </div>
                    @if (_form.UseRaw)
                    {
                        <textarea class="form-control mb-3 font-monospace" rows="3"
                                  placeholder="Server=…;Database=…;User Id=…;Password=…"
                                  @bind="_form.RawConnectionString"></textarea>
                    }

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="TestConnectionAsync">
                            <i class="bi bi-plug me-1"></i>@(_testing ? "Testing…" : "Test connection")
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="SaveProfileAsync">
                            <i class="bi bi-save me-1"></i>Save
                        </button>
                        @if (_editingId is not null)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                <i class="bi bi-x me-1"></i>Cancel
                            </button>
                        }
                    </div>

                    @if (_formError is not null)
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2">@_formError</div>
                    }
                </div>
            </div>
        </div>
    </div>

@code {
    // ---- Profile form state ----
    private string _profileName = string.Empty;
    private string _portText = string.Empty;
    private Guid? _editingId;
    private bool _testing;
    private string? _formError;
    private ConnectionFormData _form = new();

    // Database list loaded via "Load databases" — null until then (text input),
    // after which the Database field becomes a select. Cleared on engine change.
    private List<string>? _serverDatabases;
    private bool _loadingDbs;

    private IDbConnector? SelectedConnector => Registry.Resolve(_form.EngineKey);

    protected override void OnInitialized()
    {
        // The vault gate at /login owns the locked experience; everything on
        // this page needs the decrypted profiles.
        if (!SessionVault.IsUnlocked)
            Navigation.NavigateTo("/login");
    }

    // ---------------- Profile CRUD ----------------

    private void OnEngineChanged(ChangeEventArgs e)
    {
        _form.EngineKey = e.Value?.ToString() ?? "sqlite";
        // The loaded list belongs to the previously selected engine's server.
        _serverDatabases = null;
    }

    private void StartEdit(ConnectionProfile profile)
    {
        _editingId = profile.Id;
        _profileName = profile.Name;

        if (!string.IsNullOrEmpty(profile.Host))
        {
            // Structured fields were persisted with the profile, so the form can
            // be rebuilt instead of falling back to raw-string editing.
            _form = profile.ToFormData();
            _form.UseRaw = false;
        }
        else
        {
            _form = new ConnectionFormData
            {
                EngineKey = profile.EngineKey,
                // Connection strings cannot be reliably decomposed back into fields:
                // profiles saved before structured fields existed (or raw saves)
                // expose the raw string for editing.
                UseRaw = true,
                RawConnectionString = profile.ConnectionString
            };
        }

        _portText = _form.Port?.ToString() ?? string.Empty;
        _serverDatabases = null;
        _formError = null;
    }

    private void ResetForm()
    {
        _editingId = null;
        _profileName = string.Empty;
        _form = new ConnectionFormData();
        _portText = string.Empty;
        _serverDatabases = null;
        _formError = null;
    }

    /// <summary>Connection string the Save/Test actions will use.</summary>
    private (string? Error, string ConnectionString) BuildConnectionString()
    {
        if (_form.UseRaw)
        {
            if (string.IsNullOrWhiteSpace(_form.RawConnectionString))
                return ("The connection string is empty.", string.Empty);
            return (null, _form.RawConnectionString.Trim());
        }

        var connector = SelectedConnector;
        if (connector is null)
            return ("Unknown engine.", string.Empty);

        if (connector.EngineKey == "sqlite" && string.IsNullOrWhiteSpace(_form.FilePath))
            return ("Database file path is required.", string.Empty);
        if (connector.EngineKey != "sqlite" && string.IsNullOrWhiteSpace(_form.Host))
            return ("Host is required.", string.Empty);

        // Port is optional: the connector falls back to its default.
        var portError = TryApplyPort();
        if (portError is not null)
            return (portError, string.Empty);

        return (null, connector.BuildConnectionString(_form));
    }

    /// <summary>Parses the port text box into _form.Port; null when valid.</summary>
    private string? TryApplyPort()
    {
        if (string.IsNullOrWhiteSpace(_portText))
        {
            _form.Port = null;
            return null;
        }

        if (!int.TryParse(_portText.Trim(), out var port) || port is < 1 or > 65535)
            return "Port must be a number between 1 and 65535.";
        _form.Port = port;
        return null;
    }

    private async Task LoadDatabasesAsync()
    {
        _formError = null;
        var connector = SelectedConnector;
        if (connector is null || !connector.SupportsServerLevel)
            return;

        if (string.IsNullOrWhiteSpace(_form.Host))
        {
            _formError = "Host is required.";
            StateHasChanged();
            return;
        }

        var portError = TryApplyPort();
        if (portError is not null)
        {
            _formError = portError;
            StateHasChanged();
            return;
        }

        _loadingDbs = true;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await using var conn = connector.CreateConnection(connector.BuildServerConnectionString(_form));
            await conn.OpenAsync(cts.Token);
            var dbs = await connector.ListDatabasesAsync(conn, cts.Token);
            _serverDatabases = dbs;
            if (dbs.Count == 0)
                Toasts.Show("Databases", "No databases are visible to this user.", ToastKind.Warning);
        }
        catch (Exception ex)
        {
            Toasts.Show("Could not load databases", ex.Message, ToastKind.Danger);
        }
        finally
        {
            _loadingDbs = false;
            StateHasChanged();
        }
    }

    private async Task TestConnectionAsync()
    {
        _formError = null;
        var (error, cs) = BuildConnectionString();
        if (error is not null)
        {
            _formError = error;
            StateHasChanged();
            return;
        }

        var connector = SelectedConnector!;
        _testing = true;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await connector.TestConnectionAsync(cs, cts.Token);
            Toasts.Show("Connection", "Connection successful.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show("Connection failed", ex.Message, ToastKind.Danger);
        }
        finally
        {
            _testing = false;
            StateHasChanged();
        }
    }

    private void SaveProfileAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_profileName))
        {
            _formError = "Name is required.";
            StateHasChanged();
            return;
        }

        var (error, cs) = BuildConnectionString();
        if (error is not null)
        {
            _formError = error;
            StateHasChanged();
            return;
        }

        var profiles = SessionVault.Profiles.ToList();
        if (_editingId is { } editingId)
        {
            var existing = profiles.Single(p => p.Id == editingId);
            existing.Name = _profileName.Trim();
            existing.EngineKey = _form.EngineKey;
            existing.ConnectionString = cs;
            ApplyStructuredFields(existing);
        }
        else
        {
            var profile = new ConnectionProfile
            {
                Name = _profileName.Trim(),
                EngineKey = _form.EngineKey,
                ConnectionString = cs
            };
            ApplyStructuredFields(profile);
            profiles.Add(profile);
        }

        try
        {
            SessionVault.SaveProfiles(profiles);
        }
        catch (Exception ex)
        {
            // Vault file IO failure: the profile list stays unsaved, so say so —
            // silently losing a connection is worse than an inline error.
            _formError = $"Could not save to the vault: {ex.Message}";
            StateHasChanged();
            return;
        }

        ResetForm();
        StateHasChanged();
    }

    /// <summary>
    /// Persists the structured form fields so the connection string can later be
    /// rebuilt for another database (server-level switching). Raw saves keep them
    /// empty — a raw string cannot be decomposed back into fields.
    /// </summary>
    private void ApplyStructuredFields(ConnectionProfile profile)
    {
        if (_form.UseRaw)
        {
            profile.IsServerLevel = false;
            profile.Host = string.Empty;
            profile.Port = null;
            profile.Username = string.Empty;
            profile.Password = string.Empty;
            profile.SelectedDatabase = string.Empty;
            profile.EncryptMode = SqlServerEncryption.Default;
            return;
        }

        profile.IsServerLevel = _form.IsServerLevel;
        profile.Host = _form.Host.Trim();
        profile.Port = _form.Port;
        profile.Username = _form.Username;
        profile.Password = _form.Password;
        profile.SelectedDatabase = _form.Database;
        profile.EncryptMode = _form.EncryptMode;
    }

    private void DeleteProfile(ConnectionProfile profile)
    {
        var profiles = SessionVault.Profiles.Where(p => p.Id != profile.Id).ToList();
        try
        {
            SessionVault.SaveProfiles(profiles);
        }
        catch (Exception ex)
        {
            Toasts.Show("Vault error", $"Could not save to the vault: {ex.Message}", ToastKind.Danger);
            return;
        }
        if (_editingId == profile.Id)
            ResetForm();
        StateHasChanged();
    }

    private void OpenInEditor(Guid profileId) =>
        Navigation.NavigateTo($"/sql-editor?profile={profileId}");

    // ---------------- Display helpers ----------------

    private static string EngineIcon(string engineKey) => engineKey switch
    {
        "mssql" => "bi-server",
        "mysql" => "bi-database-fill",
        "postgres" => "bi-database-fill-gear",
        "sqlite" => "bi-filetype-sql",
        _ => "bi-database"
    };

    private string EngineName(string engineKey) =>
        Registry.Resolve(engineKey)?.DisplayName ?? engineKey;
}