@page "/sql-editor"
@using System.Data
@using Microsoft.AspNetCore.Components.Web
@inject ISqlEditorViewModel vm
@inject ISqlEditorService EditorService
@inject ISessionVault SessionVault
@inject IQueryStore QueryStore
@inject IDbConnectorRegistry Registry
@inject IToastService Toasts
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>SQL Editor — db-manager</PageTitle>

<div class="d-flex flex-row justify-content-between align-items-center mb-2">
    <div class="d-flex flex-row gap-2 align-items-center">
        <h3 class="h3 mb-0">SQL Editor</h3>
        @* Active connection: switching swaps schema, drafts and dialect. *@
        <select class="form-select form-select-sm w-auto" value="@_activeProfileId"
                @onchange="OnProfileChanged" title="Active connection">
            @foreach (var profile in SessionVault.Profiles)
            {
                <option value="@profile.Id">@profile.Name (@EngineName(profile.EngineKey))</option>
            }
        </select>
        @* Server-level connections: database picker, SSMS-style. Switching
           re-targets queries, reloads the schema and persists the choice. *@
        @if (vm.ActiveProfile is { IsServerLevel: true })
        {
            <select class="form-select form-select-sm w-auto" value="@vm.ActiveProfile.SelectedDatabase"
                    @onchange="OnDatabaseChanged" title="Database">
                @if (string.IsNullOrEmpty(vm.ActiveProfile.SelectedDatabase))
                {
                    <option value="">(default)</option>
                }
                @foreach (var db in _databases)
                {
                    <option value="@db">@db</option>
                }
            </select>
        }
    </div>
    <div class="d-flex flex-row gap-2 align-items-center">
        <span class="text-body-secondary small">F5 / Ctrl+E to run</span>
        @* Sidebar toggle: collapses the schema browser so the editor takes the
           full width — handy when writing long queries against known names. *@
        <button type="button" class="btn btn-sm btn-outline-secondary"
                title="@(_sidebarCollapsed ? "Show schema" : "Hide schema")"
                @onclick="ToggleSidebar">
            <i class="bi @(_sidebarCollapsed ? "bi-chevron-double-right" : "bi-chevron-double-left")"></i>
        </button>
        @* Database backup / schema export panel — operates on the active connection. *@
        <button type="button" class="btn btn-sm btn-outline-secondary"
                title="@(_showDump ? "Hide backup panel" : "Database backup & schema export")"
                @onclick="() => _showDump = !_showDump">
            <i class="bi bi-cloud-arrow-down"></i>
        </button>
        @* Saved-query library: save the editor content, reload it later, move a
           single query to/from a .sql file. Opens a modal dialog. *@
        <button type="button" class="btn btn-sm btn-outline-secondary"
                title="Saved queries" @onclick="OpenQueriesDialogAsync">
            <i class="bi bi-bookmark-star"></i>
        </button>
        <button type="button" class="btn btn-sm btn-primary" disabled="@(_isRunning || !_editorReady)"
                @onclick="RunButton_Click">
            <i class="bi bi-play-fill me-1"></i>Run
        </button>
    </div>
</div>

@if (_showDump)
{
    <div class="mb-2">
        <DatabaseDump Profile="vm.ActiveProfile" />
    </div>
}

@* ============ SAVED-QUERY LIBRARY (modal dialog) ============ *@
@* Always in the DOM; shown/hidden via dbmSite.openDialog/closeDialog (native
   showModal gives the modal + ::backdrop). Content re-renders in place. *@
<dialog id="@QueriesDialogId" class="dbm-queries-dialog">
    <div class="dbm-queries-dialog-body">
        <div class="d-flex flex-row justify-content-between align-items-center mb-1">
            <h5 class="mb-0"><i class="bi bi-bookmark-star me-2"></i>Saved queries</h5>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseQueriesDialogAsync"></button>
        </div>
        <p class="text-body-secondary small mb-3">
            The library is global; each query is tagged with the connection it was saved from.
        </p>

        @if (!QueryStore.IsAvailable)
        {
            <div class="alert alert-warning py-2 small mb-2">
                <i class="bi bi-lock-fill me-1"></i>Unlock the vault to use saved queries.
            </div>
        }
        else
        {
            @* ---- Save the current editor content ---- *@
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <input type="text" class="form-control form-control-sm query-name-input"
                       placeholder="Query name" @bind="_newQueryName" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-primary" @onclick="SaveCurrentQueryAsync">
                    <i class="bi bi-bookmark-plus me-1"></i>Save current
                </button>
                @* Import a .sql file into the editor (loads text; never executes). *@
                <span class="text-body-secondary small ms-2">Import .sql:</span>
                <InputFile OnChange="OnQueryFileSelectedAsync" @key="_queryImportKey"
                           accept=".sql,text/plain,.txt" class="form-control form-control-sm query-file-input" />
            </div>

            @* ---- Search ---- *@
            <div class="mb-2">
                <input type="text" class="form-control form-control-sm" placeholder="Search queries..."
                       @bind="_querySearch" @bind:event="oninput" />
            </div>

            @* ---- The library list ---- *@
            @if (_savedQueries.Count == 0)
            {
                <div class="text-body-secondary small">No saved queries yet.</div>
            }
            else
            {
                var filtered = FilteredQueries().ToList();
                if (filtered.Count == 0)
                {
                    <div class="text-body-secondary small">No queries match "@_querySearch".</div>
                }
                <div class="query-library-list">
                    @foreach (var q in filtered)
                    {
                        <div class="query-library-item d-flex flex-row align-items-center gap-2 border-top py-1">
                            @if (_renamingId == q.Id)
                            {
                                <input type="text" class="form-control form-control-sm" @bind="_renameText" @bind:event="oninput" />
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => CommitRenameAsync(q.Id)">OK</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelRename">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-link p-0 text-start flex-grow-1 query-name-btn"
                                        title="Load into the editor" @onclick="() => RequestLoadAsync(q.Id)">
                                    <i class="bi bi-filetype-sql me-1"></i>@q.Name
                                    @if (!string.IsNullOrEmpty(q.EngineKey))
                                    {
                                        <span class="badge text-bg-secondary ms-1">@EngineName(q.EngineKey)</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Export .sql"
                                        @onclick="() => ExportQueryAsync(q)">
                                    <i class="bi bi-download"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Rename"
                                        @onclick="() => BeginRename(q)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                        @onclick="() => RequestDelete(q.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @* ---- Inline confirms (overwrite editor / delete) ---- *@
            @if (_pendingLoadId is Guid loadId)
            {
                var loadQuery = _savedQueries.FirstOrDefault(x => x.Id == loadId);
                <div class="alert alert-danger d-flex flex-row align-items-center gap-2 mt-3 mb-0 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="flex-grow-1 small">Load "@loadQuery?.Name"? The editor content will be replaced.</span>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => LoadQueryAsync(loadId)">Load</button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelPending">Cancel</button>
                </div>
            }
            @if (_pendingDeleteId is Guid delId)
            {
                var delQuery = _savedQueries.FirstOrDefault(x => x.Id == delId);
                <div class="alert alert-danger d-flex flex-row align-items-center gap-2 mt-3 mb-0 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="flex-grow-1 small">Delete "@delQuery?.Name"? This cannot be undone.</span>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(delId)">Delete</button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelPending">Cancel</button>
                </div>
            }
        }
    </div>
</dialog>

<div class="sql-root">
    @* ============ SIDEBAR: schema browser ============ *@
    @if (!_sidebarCollapsed)
    {
        <div id="@SidebarId" class="sql-sidebar" style="@GetSidebarStyle()">
        @* Server-level connections: database switcher — same targets as the
           header dropdown. Clicking switches the active database; the schema
           groups below follow. *@
        @if (vm.ActiveProfile is { IsServerLevel: true })
        {
            <div class="sql-sidebar-group">
                <div class="sql-sidebar-group-title">Databases (@_databases.Count)</div>
                @foreach (var db in _databases)
                {
                    var isActive = db == vm.ActiveProfile.SelectedDatabase;
                    <div class="sql-sidebar-item">
                        <div class="sql-sidebar-row">
                            <span class="sql-expand-spacer"></span>
                            <button type="button" class="sql-name-btn @(isActive ? "active" : "")"
                                    title="@(isActive ? "Active database" : "Switch to this database")"
                                    @onclick="() => SwitchDatabaseAsync(db)">
                                <i class="bi bi-database me-2"></i>@db
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (vm.SchemaError is { } schemaError)
        {
            @* Unreachable host / wrong credentials: the circuit must survive this.
               Queries still run (their errors render in the results pane); only
               the schema browser and autocomplete are unavailable. *@
            <div class="p-3">
                <div class="alert alert-danger py-2 mb-2" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>@schemaError
                </div>
                <span class="text-body-secondary small">
                    Schema browser unavailable. Queries still run — switch to a
                    working connection to reload the schema.
                </span>
            </div>
        }
        else if (!vm.SchemaLoaded)
        {
            <div class="p-3 text-body-secondary">Loading schema...</div>
        }
        else
        {
            <div class="sql-sidebar-search">
                <input type="text" class="form-control form-control-sm" placeholder="Search objects..."
                       @bind="searchText" @bind:event="oninput" />
            </div>
            @* GroupBy over the enum preserves encounter order (Table, View,
               Procedure, Function), so groups render in a fixed order. *@
            @foreach (var group in FilteredSchema().GroupBy(o => o.Kind))
            {
                <div class="sql-sidebar-group">
                    <div class="sql-sidebar-group-title">@(group.Key switch
                    {
                        SchemaObjectKind.Table => "Tables",
                        SchemaObjectKind.View => "Views",
                        SchemaObjectKind.Procedure => "Procedures",
                        _ => "Functions"
                    }) (@group.Count())</div>
                    @foreach (var obj in group)
                    {
                        <div class="sql-sidebar-item">
                            <div class="sql-sidebar-row">
                                @* Expand chevron: only tables/views have columns to show. *@
                                @if (obj.Columns.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-link sql-expand-btn p-0"
                                            title="Columns"
                                            @onclick="() => ToggleExpand(obj.Name)">
                                        <i class="bi @(IsExpanded(obj.Name) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="sql-expand-spacer"></span>
                                }
                                @* Name click → insert at editor caret (dialect-quoted). *@
                                <button type="button" class="sql-name-btn" title="Insert at cursor"
                                        @onclick="() => InsertAtCursor(Connector.QuoteQualifiedName(obj.Name))">
                                    @obj.Name
                                </button>
                                @* Quick-run button: replaces editor content and executes. *@
                                @if (obj.Kind is SchemaObjectKind.Table or SchemaObjectKind.View)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary sql-top-btn"
                                            title="SELECT @QuickRowsLabel"
                                            @onclick="() => RunTop20Async(obj.Name)">
                                        @QuickRowsLabel
                                    </button>
                                }
                                else if (obj.Kind is SchemaObjectKind.Procedure)
                                {
                                    <button type="button" class="sql-proc-run" title="Insert CALL/EXEC stub"
                                            @onclick="() => InsertProc(obj.Name)">
                                        <i class="bi bi-play"></i>
                                    </button>
                                }
                                else
                                {
                                    @* Function stub: scalar and table-valued are both
                                       invoked through SELECT, so one generic stub covers both. *@
                                    <button type="button" class="sql-proc-run" title="Insert function stub"
                                            @onclick="() => InsertFunction(obj.Name)">
                                        <i class="bi bi-braces"></i>
                                    </button>
                                }
                            </div>
                            @if (IsExpanded(obj.Name))
                            {
                                <div class="sql-columns">
                                    @foreach (var col in obj.Columns)
                                    {
                                        <button type="button" class="sql-column-row" title="Insert at cursor"
                                                @onclick="() => InsertAtCursor(Connector.QuoteIdentifier(col.Name))">
                                            <span>@col.Name</span>
                                            <span class="sql-column-type">@col.DataType</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        </div>
        @* Horizontal drag handle: resizes the sidebar (px width, clamped in JS). *@
        <div id="@SidebarDragId" class="sql-sidebar-dragger" title="Drag to resize"></div>
    }

    @* ============ MAIN: editor + results split ============ *@
    <div class="sql-main">
        @* Query tabs: each holds its own SQL (a Monaco model) and result pane.
           Name and close are sibling buttons inside the tab div — nesting a
           <button> in a <button> is invalid HTML. *@
        <div class="sql-query-tabs">
            @foreach (var tab in _tabs)
            {
                <div class="sql-query-tab @(tab.Id == _activeTabId ? "active" : "")">
                    <button type="button" class="sql-query-tab-name" title="@tab.Name"
                            @onclick="() => SelectQueryTab(tab.Id)">@tab.Name</button>
                    <button type="button" class="sql-query-tab-close" title="Close query"
                            @onclick="() => CloseQueryTab(tab.Id)">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            <button type="button" class="sql-query-tab-add" title="New query"
                    @onclick="AddQueryTab">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>

        @* Before the first run this pane is flex:1 and fills everything; once a
           result exists the results pane appears below and the divider becomes
           draggable. automaticLayout:true makes Monaco track the resize. *@
        <div class="sql-editor-pane">
            <div id="@EditorDivId" class="sql-editor-host"></div>
        </div>

        @if (ActiveTab.HasRun)
        {
            var tab = ActiveTab;
            @* @key per tab: switching tabs / first run recreates these elements so
               the divider drag is re-wired cleanly (see OnAfterRenderAsync). *@
            <div id="@DividerId" @key="@(tab.Id + "-div")" class="sql-divider" title="Drag to resize"></div>
            <div id="@ResultsDivId" @key="@(tab.Id + "-res")" class="sql-results-pane" style="@GetResultsStyle(tab.SplitPct)">
                @* ---- Pending write confirmation: inline alert, not a popup, so
                       it lives where the results will land. ---- *@
                @if (tab.PendingSql is not null)
                {
                    <div class="alert alert-danger d-flex flex-row align-items-center gap-2 m-0 rounded-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="flex-grow-1">This query modifies data or structure. Run it anyway?</span>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmWrite_Click">Run</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelWrite_Click">Cancel</button>
                    </div>
                }
                else if (tab.Result is { } result)
                {
                    @* ---- Header: error or result-set tabs ---- *@
                    @if (result.Error is not null)
                    {
                        @* SSMS-style inline error (red text); the toast is only a heads-up. *@
                        <div class="sql-error">
                            <i class="bi bi-x-circle-fill me-2"></i>@result.Error
                        </div>
                    }
                    else if (result.ResultSets.Count > 1)
                    {
                        @* Multiple result sets → one tab each, like SSMS result panes. *@
                        <ul class="nav nav-tabs sql-tabs">
                            @for (var i = 0; i < result.ResultSets.Count; i++)
                            {
                                // C# `for` loops share ONE variable across all
                                // iterations, so lambdas capturing `i` would all
                                // see the final value (ResultSets.Count) by the
                                // time the user clicks — every tab opened the
                                // last result set. A per-iteration copy fixes it.
                                var index = i;
                                <li class="nav-item">
                                    <button type="button" class="nav-link @(tab.ActiveResultTab == index ? "active" : "")"
                                            @onclick="() => SelectTab(index)">
                                        Result @(index + 1) (@result.ResultSets[index].Rows.Count)
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    @* ---- Body ---- *@
                    <div class="sql-results-body">
                        @if (result.Error is not null)
                        {
                            @* error text rendered above; body left empty on purpose *@
                        }
                        else if (result.ResultSets.Count == 0)
                        {
                            <div class="sql-message">
                                @if (result.RowsAffected > 0)
                                {
                                    <span>@result.RowsAffected rows affected.</span>
                                }
                                else
                                {
                                    <span>Command completed.</span>
                                }
                            </div>
                        }
                        else
                        {
                            var table = result.ResultSets[Math.Min(tab.ActiveResultTab, result.ResultSets.Count - 1)];
                            <table class="sql-grid">
                                <thead>
                                    <tr>
                                        @foreach (DataColumn col in table.Columns)
                                        {
                                            <th class="@(IsNumericType(col.DataType) ? "num" : "")">@col.ColumnName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Virtualize: a quick SELECT on a big table can be
                                       thousands of rows; only the visible slice renders. *@
                                    <Virtualize Items="GetRows(table)" ItemSize="28" OverscanCount="5">
                                        <tr>
                                            @{
                                                var row = context as DataRow;
                                                foreach (DataColumn col in table.Columns)
                                                {
                                                    var value = row![col];
                                                    <td class="@(IsNumericType(col.DataType) ? "num" : "")">
                                                        @if (value is DBNull or null)
                                                        {
                                                            <em class="sql-null">NULL</em>
                                                        }
                                                        else
                                                        {
                                                            <span title="@value.ToString()">@value</span>
                                                        }
                                                    </td>
                                                }
                                            }
                                        </tr>
                                    </Virtualize>
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="sql-results-footer">
                        Elapsed: @result.ElapsedMs ms — Rows: @(result.ResultSets.Count > 0
                            ? result.ResultSets[Math.Min(tab.ActiveResultTab, result.ResultSets.Count - 1)].Rows.Count
                            : result.RowsAffected)
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    // Stable DOM ids: JS interop (Monaco init, split drags) looks elements up by id.
    private const string EditorDivId = "dbm-sql-editor";
    private const string DividerId = "dbm-sql-divider";
    private const string ResultsDivId = "dbm-sql-results";
    private const string SidebarId = "dbm-sql-sidebar";
    private const string SidebarDragId = "dbm-sql-sidebar-drag";
    private const string QueriesDialogId = "dbm-queries-dialog";

    // Set by OnEditorReady (JS callback): the Run button and query reads must not
    // fire before Monaco exists — the AMD require() engine download is async.
    private bool _editorReady;
    private bool _isRunning;

    // Query tabs (SSMS-style). Each tab's SQL text lives in its own Monaco model
    // (JS side); the per-tab result state lives here.
    private List<QueryTab> _tabs = [];
    private Guid _activeTabId;
    private int _tabCounter;
    private QueryTab ActiveTab => _tabs.First(t => t.Id == _activeTabId);

    /// <summary>One query tab: its own results, result-set selection and split.</summary>
    private sealed class QueryTab
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Name { get; set; } = string.Empty;
        public bool HasRun { get; set; }
        public int ActiveResultTab { get; set; }
        public double SplitPct { get; set; } = 50;
        public SqlEditorResult? Result { get; set; }
        public string? PendingSql { get; set; }
    }

    // Sidebar width/collapse. The dragger element only exists while expanded, so
    // its JS wiring must be re-created after every expand — _sidebarWired tracks
    // whether the CURRENT dragger element has its pointer listeners attached.
    private double _sidebarWidth = 280;
    private bool _sidebarCollapsed;

    // Database backup / schema export panel (DatabaseDump component).
    private bool _showDump;
    private bool _sidebarWired;

    // Saved-query library (modal dialog). The list is pulled from the scoped
    // IQueryStore each time the dialog opens (cheap: a handful of rows, one SELECT).
    private List<SavedQuery> _savedQueries = [];
    private string _querySearch = string.Empty;
    private string _newQueryName = string.Empty;
    private Guid? _renamingId;
    private string _renameText = string.Empty;
    private Guid? _pendingLoadId;
    private Guid? _pendingDeleteId;
    private int _queryImportKey;

    // Sidebar UI state.
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private string searchText = string.Empty;

    // Active connection id (dropdown binding, string for <select>).
    private string _activeProfileId = string.Empty;

    // Databases of the active server-level connection (empty otherwise).
    private List<string> _databases = [];

    private DotNetObjectReference<SqlEditor>? _dotnetRef;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "profile")]
    public Guid? ProfileId { get; set; }

    /// <summary>Connector of the active connection (never null once the page renders).</summary>
    private IDbConnector Connector => Registry.Resolve(vm.ActiveProfile?.EngineKey ?? "")!;

    /// <summary>"TOP 20" or "LIMIT 20", whichever the dialect uses.</summary>
    private string QuickRowsLabel =>
        Connector.DialectConfig.TopSnippet.Contains("TOP") ? "TOP 20" : "LIMIT 20";

    protected override async Task OnInitializedAsync()
    {
        // Everything here needs the unlocked vault. Locked circuits go to the
        // vault gate; unlocked-but-empty ones have nothing to edit, so they
        // land on Connections to create a profile.
        if (!SessionVault.IsUnlocked)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (SessionVault.Profiles.Count == 0)
        {
            Navigation.NavigateTo("/connections");
            return;
        }

        var profile = SessionVault.GetProfile(ProfileId ?? Guid.Empty)
            ?? SessionVault.Profiles[0];
        _activeProfileId = profile.Id.ToString();

        // First query tab. Its Monaco model is created in dbSqlEditor.init
        // (seeded from the profile draft), so the id must exist before init runs.
        _tabs.Add(new QueryTab { Name = $"Query {++_tabCounter}" });
        _activeTabId = _tabs[0].Id;

        // One schema round trip per circuit per connection; the ViewModel caches it.
        await vm.LoadSchemaAsync(profile);
        await RefreshDatabasesAsync();

        // Cross-database IntelliSense: eagerly load every database's schema for
        // server-level connections whose engine can query across databases.
        if (profile is { IsServerLevel: true } && Connector.SupportsCrossDatabaseQueries)
        {
            await vm.LoadServerSchemaAsync(profile);
            if (_editorReady)
                await PushSchemaAsync(); // Monaco arrived before the payload: re-push
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (vm.ActiveProfile is null)
            return; // redirected to /connections

        if (firstRender)
        {
            // This wrapper is what receives the JS callbacks below; it is disposed
            // with the page so JS never holds a dangling reference.
            _dotnetRef = DotNetObjectReference.Create(this);

            // Monaco init: theme matches the app's Bootstrap dark mode at load
            // time (a mid-session theme switch reloads the page anyway). The
            // editor draft is keyed per connection profile.
            var isDark = await JS.InvokeAsync<string>("dbmSite.getTheme") == "dark";
            await JS.InvokeVoidAsync("dbSqlEditor.init", EditorDivId, _dotnetRef, isDark, _activeTabId.ToString(), _activeProfileId);
            return;
        }

        // The divider and results pane only exist in the DOM while the active tab
        // has results. The pane is @key-ed per tab (fresh element on each switch /
        // first run) and initSplit self-guards, so calling it whenever results are
        // visible wires exactly once without duplicate listeners.
        if (ActiveTab.HasRun)
            await JS.InvokeVoidAsync("dbSqlEditor.initSplit", DividerId, ResultsDivId, _dotnetRef);

        // Sidebar dragger: (re)created on every expand, so wire it whenever it
        // is present but not yet wired.
        if (!_sidebarCollapsed && !_sidebarWired)
        {
            _sidebarWired = true;
            await JS.InvokeVoidAsync("dbSqlEditor.initSidebarSplit", SidebarDragId, SidebarId, _dotnetRef);
        }
    }

    /// <summary>JS → C#: Monaco finished loading (the CDN engine download completed).</summary>
    [JSInvokable]
    public async Task OnEditorReady()
    {
        _editorReady = true;
        await PushSchemaAsync();
    }

    /// <summary>
    /// Pushes the active schema + dialect to Monaco. The serializer options MUST
    /// match what the JS expects: camelCase property keys (obj.name / obj.kind /
    /// obj.columns — PascalCase would make every JS lookup return undefined and
    /// the completion provider throw) and enum values as text ("Table"/"View"/
    /// "Procedure") so JS can compare kind strings.
    /// </summary>
    private async Task PushSchemaAsync()
    {
        if (vm.ActiveProfile is null)
            return;

        var options = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
            Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
        };
        var payload = new { vm.Schema, Dialect = Connector.DialectConfig, Databases = vm.ServerSchema };
        await JS.InvokeVoidAsync("dbSqlEditor.setSchema", System.Text.Json.JsonSerializer.Serialize(payload, options));

        StateHasChanged();
    }

    /// <summary>JS → C#: F5 / Ctrl+E / Ctrl+Enter pressed inside the editor.</summary>
    [JSInvokable]
    public Task OnRunRequested() => RunQueryAsync();

    /// <summary>JS → C#: the divider drag ended; keep C# state in sync for re-renders.</summary>
    [JSInvokable]
    public Task OnSplitChanged(double pct)
    {
        ActiveTab.SplitPct = pct;
        return Task.CompletedTask;
    }

    /// <summary>JS → C#: the sidebar drag ended; persist the width for re-renders.</summary>
    [JSInvokable]
    public Task OnSidebarSplitChanged(double px)
    {
        _sidebarWidth = px;
        return Task.CompletedTask;
    }

    /// <summary>Dropdown change: switch the active connection.</summary>
    private async Task OnProfileChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id))
            return;
        if (vm.ActiveProfile?.Id == id)
            return;

        var profile = SessionVault.GetProfile(id);
        if (profile is null)
            return;

        _activeProfileId = id.ToString();
        // Shared connection: the previous connection's results no longer apply,
        // so clear them on every tab — the tab TEXT is kept (tabs persist across
        // connection switches). Only the draft autosave target re-points.
        foreach (var t in _tabs)
        {
            t.Result = null;
            t.HasRun = false;
            t.PendingSql = null;
            t.ActiveResultTab = 0;
        }
        if (_editorReady)
            await JS.InvokeVoidAsync("dbSqlEditor.setDraftKey", _activeProfileId);

        await vm.LoadSchemaAsync(profile); // switches + invalidates the cache
        await RefreshDatabasesAsync();

        // Cross-DB IntelliSense for the newly selected server-level profile.
        if (profile is { IsServerLevel: true } && Connector.SupportsCrossDatabaseQueries)
            await vm.LoadServerSchemaAsync(profile);

        if (_editorReady)
            await PushSchemaAsync();
    }

    /// <summary>
    /// Database dropdown change on a server-level connection: re-targets the
    /// connection string (all later GO batches/queries follow), persists the
    /// choice and reloads the schema. Ignored mid-run so one script's batches
    /// never straddle two databases.
    /// </summary>
    private Task OnDatabaseChanged(ChangeEventArgs e) =>
        SwitchDatabaseAsync(e.Value?.ToString());

    /// <summary>
    /// Switches the active database of a server-level connection — the header
    /// dropdown and the sidebar database list both land here. Re-targets the
    /// connection string (all later GO batches/queries follow), persists the
    /// choice and reloads the schema. Ignored mid-run so one script's batches
    /// never straddle two databases.
    /// </summary>
    private async Task SwitchDatabaseAsync(string? db)
    {
        var profile = vm.ActiveProfile;
        if (profile is null || db is null || _isRunning)
            return;
        if (db == profile.SelectedDatabase)
            return;

        profile.SelectedDatabase = db;
        // The connection string is the ONLY thing execution reads — rebuilding
        // it here re-targets every future connection (per GO batch included).
        profile.ConnectionString = Connector.BuildConnectionString(profile.ToFormData());

        try
        {
            SessionVault.SaveProfiles(SessionVault.Profiles.ToList());
        }
        catch (Exception ex)
        {
            Toasts.Show("Vault error", $"Database selection not saved: {ex.Message}", ToastKind.Danger);
        }

        // Results belong to the previous database.
        foreach (var t in _tabs)
        {
            t.Result = null;
            t.HasRun = false;
            t.PendingSql = null;
            t.ActiveResultTab = 0;
        }

        await vm.ReloadSchemaAsync();
        await RefreshDatabasesAsync();
        if (_editorReady)
            await PushSchemaAsync();
    }

    /// <summary>
    /// Loads the server's database list for a server-level connection. Never
    /// throws (server down, lost grant): the last list is kept so the dropdown
    /// stays usable, and the selected database is always offered even when the
    /// fresh list no longer contains it.
    /// </summary>
    private async Task RefreshDatabasesAsync()
    {
        if (vm.ActiveProfile is not { IsServerLevel: true } profile)
        {
            _databases = [];
            return;
        }

        try
        {
            _databases = await EditorService.ListDatabasesAsync(profile);
        }
        catch (Exception ex)
        {
            Toasts.Show("Could not load databases", ex.Message, ToastKind.Danger);
        }

        if (!string.IsNullOrEmpty(profile.SelectedDatabase)
            && !_databases.Contains(profile.SelectedDatabase, StringComparer.Ordinal))
        {
            _databases = [profile.SelectedDatabase, .. _databases];
        }
    }

    /// <summary>
    /// Header button: collapses/expands the schema sidebar. On collapse the
    /// dragger element is destroyed (so its JS listeners must be re-created on
    /// the next expand — see OnAfterRenderAsync/_sidebarWired).
    /// </summary>
    private void ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        if (_sidebarCollapsed)
            _sidebarWired = false;
    }

    private Task RunButton_Click() => RunQueryAsync();

    /// <summary>
    /// Reads the editor content and executes it — single entry point for the Run
    /// button and the editor keybindings.
    /// </summary>
    private async Task RunQueryAsync()
    {
        if (!_editorReady || _isRunning)
            return;

        var sql = await JS.InvokeAsync<string>("dbSqlEditor.getValue", EditorDivId);
        await ExecuteSqlAsync(sql);
    }

    /// <summary>
    /// Sidebar quick-peek: replaces the editor content (the natural expectation
    /// for a quick look) and runs immediately. Always a read, so no confirm dialog.
    /// Dialect-aware: TOP for T-SQL, LIMIT for the rest, quoted per engine.
    /// </summary>
    private async Task RunTop20Async(string objectName)
    {
        if (!_editorReady || _isRunning)
            return;

        var sql = Connector.BuildSelectTopN(objectName, 20);
        await JS.InvokeVoidAsync("dbSqlEditor.setValue", EditorDivId, sql);
        await ExecuteSqlAsync(sql);
    }

    /// <summary>Common execution path with the write gate and run/finish bookkeeping.</summary>
    private async Task ExecuteSqlAsync(string sql)
    {
        // Write gate: the IsWriteStatement heuristic only decides WHETHER the
        // confirm alert appears; the actual execution is identical either way.
        if (vm.IsWriteStatement(sql))
        {
            ActiveTab.PendingSql = sql;
            ActiveTab.HasRun = true; // results pane becomes visible to host the confirm alert
            StateHasChanged();
            return;
        }

        await DoExecuteAsync(sql);
    }

    private async Task ConfirmWrite_Click()
    {
        var sql = ActiveTab.PendingSql;
        await DoExecuteAsync(sql!);
    }

    private void CancelWrite_Click()
    {
        ActiveTab.PendingSql = null;
        // If nothing was ever executed, collapse the results pane back — there is
        // nothing to show and the editor should get the full height again.
        if (ActiveTab.Result is null)
            ActiveTab.HasRun = false;
        StateHasChanged();
    }

    private async Task DoExecuteAsync(string sql)
    {
        // Capture the tab up front: the user may switch tabs while the query
        // runs, and the result must land on the tab it was launched from.
        var tab = ActiveTab;
        _isRunning = true;
        tab.PendingSql = null;
        StateHasChanged();
        try
        {
            var result = await vm.ExecuteAsync(sql);
            tab.Result = result;
            tab.HasRun = true;
            tab.ActiveResultTab = 0;

            if (result.Error is not null)
                ShowErrorToast(result.Error);
        }
        finally
        {
            _isRunning = false;
            StateHasChanged();
        }
    }

    private void ShowErrorToast(string message) =>
        Toasts.Show("SQL error", message, ToastKind.Danger, 8);

    private Task InsertAtCursor(string text) =>
        JS.InvokeVoidAsync("dbSqlEditor.insertAtCursor", EditorDivId, text).AsTask();

    /// <summary>Proc run icon: inserts an EXEC/CALL stub so the user fills in parameters.</summary>
    private Task InsertProc(string procName) =>
        InsertAtCursor(Connector.BuildExecStub(procName));

    /// <summary>Function icon: inserts a SELECT stub (scalar and table-valued
    /// functions are both invoked through SELECT, differing only in the prefix /
    /// FROM shape — the user adjusts that around the inserted name).</summary>
    private Task InsertFunction(string funcName) =>
        InsertAtCursor(Connector.BuildFunctionStub(funcName));

    private bool IsExpanded(string name) => _expanded.Contains(name);

    private void ToggleExpand(string name)
    {
        if (!_expanded.Remove(name))
            _expanded.Add(name);
    }

    private void SelectTab(int index) => ActiveTab.ActiveResultTab = index;

    // ---------------- Query tabs ----------------

    /// <summary>Adds a new, empty query tab and makes it active.</summary>
    private Task AddQueryTab()
    {
        var tab = new QueryTab { Name = $"Query {++_tabCounter}" };
        _tabs.Add(tab);
        return ActivateQueryTabAsync(tab.Id);
    }

    private Task SelectQueryTab(Guid id) => ActivateQueryTabAsync(id);

    /// <summary>Switches the active query tab (and the Monaco model it shows).</summary>
    private async Task ActivateQueryTabAsync(Guid id)
    {
        if (_activeTabId == id)
            return;
        _activeTabId = id;
        if (_editorReady)
            await JS.InvokeVoidAsync("dbSqlEditor.openTab", EditorDivId, id.ToString());
        StateHasChanged();
    }

    /// <summary>
    /// Closes a query tab. The last remaining tab is cleared in place (the page
    /// always keeps at least one); otherwise the tab is dropped and, when it was
    /// active, a neighbour takes over.
    /// </summary>
    private async Task CloseQueryTab(Guid id)
    {
        var index = _tabs.FindIndex(t => t.Id == id);
        if (index < 0)
            return;

        if (_tabs.Count == 1)
        {
            // Never leave zero tabs: clear the sole tab instead of removing it.
            if (_editorReady)
                await JS.InvokeVoidAsync("dbSqlEditor.setValue", EditorDivId, string.Empty);
            var only = _tabs[0];
            only.HasRun = false;
            only.Result = null;
            only.PendingSql = null;
            only.ActiveResultTab = 0;
            only.SplitPct = 50;
            StateHasChanged();
            return;
        }

        if (_editorReady)
            await JS.InvokeVoidAsync("dbSqlEditor.closeTab", EditorDivId, id.ToString());

        _tabs.RemoveAt(index);
        if (_activeTabId == id)
        {
            // The neighbour that took this slot, or the new last tab.
            _activeTabId = _tabs[Math.Min(index, _tabs.Count - 1)].Id;
            if (_editorReady)
                await JS.InvokeVoidAsync("dbSqlEditor.openTab", EditorDivId, _activeTabId.ToString());
        }
        StateHasChanged();
    }

    /// <summary>Sidebar filter: object name OR any column name matching (case-insensitive).</summary>
    private IEnumerable<SchemaObject> FilteredSchema()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return vm.Schema;

        var term = searchText.Trim();
        return vm.Schema.Where(o =>
            o.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || o.Columns.Any(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

    private string EngineName(string engineKey) =>
        Registry.Resolve(engineKey)?.DisplayName ?? engineKey;

    /// <summary>Rows as a plain list so <c>Virtualize</c> gets an indexable collection.</summary>
    private static List<DataRow> GetRows(DataTable table) => table.Rows.Cast<DataRow>().ToList();

    /// <summary>Right-align numerics like SSMS; the column type decides the alignment.</summary>
    private static bool IsNumericType(Type type) =>
        type == typeof(byte) || type == typeof(sbyte) || type == typeof(short) || type == typeof(ushort)
        || type == typeof(int) || type == typeof(uint) || type == typeof(long) || type == typeof(ulong)
        || type == typeof(float) || type == typeof(double) || type == typeof(decimal);

    /// <summary>
    /// Inline style for the results pane: flex-basis carries the divider position.
    /// During a drag JS updates the style directly; this only re-seeds the
    /// C#-known value so re-renders do not undo the last drag.
    /// </summary>
    private string GetResultsStyle(double pct) => $"flex-basis: {pct.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    /// <summary>Inline width for the sidebar; JS updates it directly while dragging,
    /// this re-seeds the C#-known value so re-renders keep the dragged width.</summary>
    private string GetSidebarStyle() => $"width: {_sidebarWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    // ---------------- Saved-query library ----------------

    /// <summary>Opens the saved-query dialog (reloads the list, then showModal).</summary>
    private async Task OpenQueriesDialogAsync()
    {
        ReloadQueries();
        await JS.InvokeVoidAsync("dbmSite.openDialog", QueriesDialogId);
    }

    /// <summary>Live filter: name OR SQL body OR engine tag contains the term.</summary>
    private IEnumerable<SavedQuery> FilteredQueries()
    {
        if (string.IsNullOrWhiteSpace(_querySearch))
            return _savedQueries;

        var term = _querySearch.Trim();
        return _savedQueries.Where(q =>
            q.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || q.Sql.Contains(term, StringComparison.OrdinalIgnoreCase)
            || q.EngineKey.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private async Task CloseQueriesDialogAsync() =>
        await JS.InvokeVoidAsync("dbmSite.closeDialog", QueriesDialogId);

    /// <summary>Reads the library into component state. Never throws (never-throw UI contract).</summary>
    private void ReloadQueries()
    {
        _pendingLoadId = null;
        _pendingDeleteId = null;
        _renamingId = null;
        if (!QueryStore.IsAvailable)
        {
            _savedQueries = [];
            return;
        }
        try
        {
            _savedQueries = QueryStore.GetAll();
        }
        catch (Exception ex)
        {
            Toasts.Show("Saved queries", ex.Message, ToastKind.Danger);
            _savedQueries = [];
        }
    }

    /// <summary>Saves the current editor content under the typed name.</summary>
    private async Task SaveCurrentQueryAsync()
    {
        if (!QueryStore.IsAvailable || !_editorReady)
            return;

        var name = _newQueryName.Trim();
        if (name.Length == 0)
        {
            Toasts.Show("Save", "Enter a name for the query.", ToastKind.Warning);
            return;
        }

        var sql = await JS.InvokeAsync<string>("dbSqlEditor.getValue", EditorDivId);
        if (string.IsNullOrWhiteSpace(sql))
        {
            Toasts.Show("Save", "The editor is empty.", ToastKind.Warning);
            return;
        }

        try
        {
            QueryStore.Add(name, sql, vm.ActiveProfile?.Id, vm.ActiveProfile?.EngineKey ?? string.Empty);
            _newQueryName = string.Empty;
            ReloadQueries();
            Toasts.Show("Saved", $"Query \"{name}\" saved.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show("Save failed", ex.Message, ToastKind.Danger);
        }
    }

    /// <summary>Load click: overwrite the editor, but confirm when it already has content.</summary>
    private async Task RequestLoadAsync(Guid id)
    {
        var current = _editorReady ? await JS.InvokeAsync<string>("dbSqlEditor.getValue", EditorDivId) : string.Empty;
        if (string.IsNullOrWhiteSpace(current) || current.StartsWith("-- Write a query", StringComparison.Ordinal))
        {
            await LoadQueryAsync(id);
            return;
        }
        _pendingLoadId = id;
    }

    private async Task LoadQueryAsync(Guid id)
    {
        var query = _savedQueries.FirstOrDefault(x => x.Id == id);
        if (query is null)
            return;
        await JS.InvokeVoidAsync("dbSqlEditor.setValue", EditorDivId, query.Sql);
        _pendingLoadId = null;
        await JS.InvokeVoidAsync("dbmSite.closeDialog", QueriesDialogId); // pick → back to the editor
        Toasts.Show("Query loaded", query.Name, ToastKind.Success);
    }

    private void BeginRename(SavedQuery query)
    {
        _renamingId = query.Id;
        _renameText = query.Name;
        _pendingLoadId = null;
        _pendingDeleteId = null;
    }

    private void CancelRename()
    {
        _renamingId = null;
        _renameText = string.Empty;
    }

    private void CommitRenameAsync(Guid id)
    {
        var name = _renameText.Trim();
        if (name.Length == 0)
        {
            Toasts.Show("Rename", "Name cannot be empty.", ToastKind.Warning);
            return;
        }
        try
        {
            QueryStore.Rename(id, name);
        }
        catch (Exception ex)
        {
            Toasts.Show("Rename failed", ex.Message, ToastKind.Danger);
            return;
        }
        CancelRename();
        ReloadQueries();
    }

    private void RequestDelete(Guid id)
    {
        _pendingDeleteId = id;
        _pendingLoadId = null;
        _renamingId = null;
    }

    private void ConfirmDeleteAsync(Guid id)
    {
        try
        {
            QueryStore.Delete(id);
        }
        catch (Exception ex)
        {
            Toasts.Show("Delete failed", ex.Message, ToastKind.Danger);
            return;
        }
        ReloadQueries();
    }

    private void CancelPending()
    {
        _pendingLoadId = null;
        _pendingDeleteId = null;
    }

    /// <summary>Single query → .sql download.</summary>
    private async Task ExportQueryAsync(SavedQuery query)
    {
        var name = SafeFileName(query.Name) + ".sql";
        await JS.InvokeVoidAsync("dbmSite.downloadTextFile", name, "application/sql", query.Sql);
        Toasts.Show("Export", $"Downloaded {name}.", ToastKind.Success);
    }

    /// <summary>Import a .sql file: loads its text into the editor (does not execute).</summary>
    private async Task OnQueryFileSelectedAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 5 * 1024 * 1024;
        try
        {
            var file = e.File;
            if (file.Size > maxBytes)
            {
                Toasts.Show("Import failed", "The file is larger than 5 MB.", ToastKind.Danger);
                return;
            }
            using var reader = new StreamReader(file.OpenReadStream(maxBytes));
            var text = await reader.ReadToEndAsync();
            await JS.InvokeVoidAsync("dbSqlEditor.setValue", EditorDivId, text);
            Toasts.Show("Import", $"\"{file.Name}\" loaded into the editor.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show("Import failed", ex.Message, ToastKind.Danger);
        }
        finally
        {
            _queryImportKey++; // fresh InputFile so the same file can be re-picked
        }
    }

    /// <summary>Filesystem-safe file name from a query name.</summary>
    private static string SafeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray()).Trim();
        return cleaned.Length == 0 ? "query" : cleaned;
    }

    public void Dispose()
    {
        // Fire-and-forget on purpose: Dispose must be sync, and at teardown the
        // circuit is going away anyway — a missed JS call harms nothing.
        _ = JS.InvokeVoidAsync("dbSqlEditor.dispose", EditorDivId);
        _dotnetRef?.Dispose();
    }
}