<!DOCTYPE html>
@inject DbManager.Abstractions.IPreferenceStore Prefs
@* data-bs-theme is rendered SERVER-side from the persisted preference, so the
   saved theme is applied to the very first paint (login page included) with no
   flash. The interactive toggle in MainLayout updates the attribute live and
   writes back through the same store. *@
<html lang="en" data-bs-theme="@Prefs.Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    @* Login page identity: Space Grotesk (display/body) + IBM Plex Mono
       (security metadata). Falls back to system-ui/monospace when offline. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DbManager.styles.css"]" />
    @* Execution-plan renderer (SSMS-style operator graph from ShowPlan XML).
       Served locally (not CDN) so the plan view never depends on a network
       fetch. qp.css reads the qp_icons.png sprite next to it, and the JS reads
       the .qp-* classes from this CSS — keep js/css/icons on the same version. *@
    <link rel="stylesheet" href="@Assets["lib/html-query-plan/css/qp.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Theme is set server-side on <html> above — no pre-paint script needed. *@
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    @* Loaded before blazor.web.js so each is ready as soon as the circuit starts
       calling it. site.js first — theme helpers are used by the layout. *@
    <script src="js/site.js"></script>
    @* Graphical execution plan (html-query-plan, served locally). MUST load
       BEFORE Monaco's AMD loader below: qp.min.js is a UMD bundle that checks
       `define.amd`, and Monaco's loader installs a global AMD `define` — load
       order reversed and QP registers as an anonymous AMD module instead of
       exposing the global `window.QP` the interop needs. *@
    <script src="@Assets["lib/html-query-plan/dist/qp.min.js"]"></script>
    <script src="js/query-plan.js"></script>
    @* Monaco AMD loader for the SQL editor page. Only this ~3 KB bootstrap comes
       from the CDN; the editor engine (~2 MB) is downloaded lazily by
       js/sql-editor.js on the first visit to the page. Pinned version — MUST
       match require.config paths in wwwroot/js/sql-editor.js. *@
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>
    <script src="js/sql-editor.js"></script>
    @* Results-grid helpers: column resize / auto-fit and clipboard. Plain DOM,
       independent of the Monaco loader above. *@
    <script src="js/result-grid.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>