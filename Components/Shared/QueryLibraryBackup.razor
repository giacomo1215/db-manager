@* Saved-query library backup: collapsible card on the Connections page,
   mirroring BackupRestore for connections. Encrypted export/restore use the
   vault master password; plaintext export/import need an unlocked session
   (queries are decrypted under the derived key). *@
@using System.IO
@inject IVaultService Vault
@inject IQueryStore QueryStore
@inject IQueryBackupService QueryBackup
@inject ISessionVault SessionVault
@inject IToastService Toasts
@inject IJSRuntime JS

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">
            <button type="button" class="btn btn-sm btn-outline-secondary me-2"
                    @onclick="() => _showBackup = !_showBackup">
                <i class="bi bi-chevron-@(_showBackup ? "down" : "right")"></i>
            </button>
            <i class="bi bi-bookmark-star me-2"></i>Saved Queries Backup
        </h5>
        @if (_showBackup)
        {
            @if (!SessionVault.IsUnlocked)
            {
                <div class="alert alert-warning py-2 small mb-0">
                    <i class="bi bi-lock-fill me-1"></i>Unlock the vault to export or restore saved queries.
                </div>
            }
            else
            {
                <h6 class="card-subtitle mb-2 text-body-secondary"><i class="bi bi-box-arrow-up me-1"></i>Export</h6>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-outline-primary" @onclick="ExportEncryptedAsync">
                        <i class="bi bi-shield-lock me-1"></i>Encrypted copy
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ExportPlaintextAsync">
                        <i class="bi bi-filetype-json me-1"></i>Plaintext JSON
                    </button>
                </div>
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    The plaintext export contains the full SQL of every saved query
                    in readable form. Store it securely.
                </div>

                <h6 class="card-subtitle mb-2 text-body-secondary">
                    <i class="bi bi-box-arrow-in-down me-1"></i>Restore (replaces the whole library)
                </h6>
                @* @key forces a fresh file input once a restore completes or is cancelled. *@
                <InputFile OnChange="OnImportFileSelectedAsync" @key="_importInputKey"
                           accept=".json,application/json" class="form-control" />

                @if (_importFormat is not null && _importError is null)
                {
                    <div class="alert alert-info py-2 small mt-2 mb-0">
                        <i class="bi bi-file-earmark me-1"></i>@_importFileName — @_importSummary
                    </div>
                }
                @if (_importFormat == QueryBackupFormat.EncryptedQueries && !_backupPasswordChecked && _importError is null)
                {
                    <div class="mb-2 mt-2">
                        <label class="form-label">Backup's master password</label>
                        <input type="password" class="form-control" @bind="_backupPassword" />
                    </div>
                    <button type="button" class="btn btn-outline-primary" @onclick="CheckBackupPasswordAsync">
                        <i class="bi bi-shield-check me-1"></i>Check password
                    </button>
                }
                @if (_pendingRestore)
                {
                    <div class="alert alert-danger d-flex flex-row align-items-center gap-2 mt-2 mb-0 py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="flex-grow-1 small">Restoring replaces the whole saved-query library. Continue?</span>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmRestoreAsync">Restore</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelRestore">Cancel</button>
                    </div>
                }
                @if (_importError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0 py-2">@_importError</div>
                }
            }
        }
    </div>
</div>

@code {
    private const int MaxBackupSizeBytes = 20 * 1024 * 1024; // a library is small; abuse protection only

    private bool _showBackup;

    // ---- Import state machine ----
    private int _importInputKey;
    private string _importJson = string.Empty;
    private string _importFileName = string.Empty;
    private QueryBackupFormat? _importFormat;
    private string? _importSummary;
    private bool _backupPasswordChecked;
    private string _backupPassword = string.Empty;
    private bool _pendingRestore;
    private string? _importError;
    private List<SavedQuery> _importQueries = [];

    // ---------------- Export ----------------

    private async Task ExportEncryptedAsync()
    {
        try
        {
            var json = QueryBackup.BuildEncryptedExport(QueryStore.GetAll(), SessionVault.DerivedKey!, Vault.CurrentKdf);
            var name = $"db-manager-queries-encrypted-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            await JS.InvokeVoidAsync("dbmSite.downloadTextFile", name, "application/json", json);
            Toasts.Show("Backup", "Encrypted saved-query copy downloaded.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show("Backup failed", ex.Message, ToastKind.Danger);
        }
    }

    private async Task ExportPlaintextAsync()
    {
        try
        {
            var json = QueryBackup.BuildPlaintextExport(QueryStore.GetAll());
            var name = $"db-manager-queries-plaintext-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            await JS.InvokeVoidAsync("dbmSite.downloadTextFile", name, "application/json", json);
            Toasts.Show("Backup", "Plaintext saved-query export downloaded — handle it with care.", ToastKind.Warning);
        }
        catch (Exception ex)
        {
            Toasts.Show("Backup failed", ex.Message, ToastKind.Danger);
        }
    }

    // ---------------- Import ----------------

    private async Task OnImportFileSelectedAsync(InputFileChangeEventArgs e)
    {
        ResetImport();
        try
        {
            var file = e.File;
            if (file.Size > MaxBackupSizeBytes)
            {
                _importError = "The file is larger than 20 MB.";
                return;
            }
            using var reader = new StreamReader(file.OpenReadStream(MaxBackupSizeBytes));
            _importJson = await reader.ReadToEndAsync();
            _importFileName = file.Name;

            switch (QueryBackup.DetectFormat(_importJson))
            {
                case QueryBackupFormat.Unrecognized:
                    _importError = "Unrecognized file — expected an encrypted saved-query backup or a plaintext export.";
                    break;

                case QueryBackupFormat.PlaintextExport:
                    if (QueryBackup.TryReadPlaintextExport(_importJson, out var queries, out var err))
                    {
                        _importFormat = QueryBackupFormat.PlaintextExport;
                        _importQueries = queries;
                        _importSummary = $"Plaintext export — {queries.Count} query(ies).";
                        _pendingRestore = true;
                    }
                    else
                    {
                        _importError = err;
                    }
                    break;

                case QueryBackupFormat.EncryptedQueries:
                    // Password check comes next (button below); nothing written yet.
                    _importFormat = QueryBackupFormat.EncryptedQueries;
                    _importSummary = "Encrypted saved-query backup.";
                    break;
            }
        }
        catch (IOException)
        {
            _importError = "The file is larger than 20 MB.";
        }
        catch (Exception ex)
        {
            _importError = $"Could not read the file: {ex.Message}";
        }
    }

    private async Task CheckBackupPasswordAsync()
    {
        _importError = null;
        // PBKDF2 is deliberately slow: keep it off the circuit.
        var ok = await Task.Run(() =>
            QueryBackup.TryReadEncryptedExport(_importJson, _backupPassword, out var queries, out var error)
                ? (Ok: true, Queries: queries, Error: (string?)null)
                : (Ok: false, Queries: new List<SavedQuery>(), Error: error));
        if (!ok.Ok)
        {
            _importError = ok.Error;
            return;
        }
        _backupPasswordChecked = true;
        _importQueries = ok.Queries;
        _importSummary = $"Encrypted saved-query backup — {ok.Queries.Count} query(ies).";
        _pendingRestore = true;
    }

    private async Task ConfirmRestoreAsync()
    {
        _importError = null;
        try
        {
            if (!SessionVault.IsUnlocked)
            {
                _importError = "Unlock the vault first to restore saved queries.";
                return;
            }
            if (_importFormat == QueryBackupFormat.EncryptedQueries)
            {
                // Re-validate before writing: the password field may have changed
                // since the check. Disk stays untouched while the password is wrong.
                var check = await Task.Run(() =>
                    QueryBackup.TryReadEncryptedExport(_importJson, _backupPassword, out var queries, out var error)
                        ? (Ok: true, Queries: queries, Error: (string?)null)
                        : (Ok: false, Queries: new List<SavedQuery>(), Error: error));
                if (!check.Ok)
                {
                    _importError = check.Error;
                    return;
                }
                _importQueries = check.Queries;
            }

            // Re-encrypts every query under the current session key — replace-all.
            QueryStore.ReplaceAll(_importQueries);
            Toasts.Show("Restore", $"{_importQueries.Count} saved query(ies) restored.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            _importError = $"Could not restore: {ex.Message}"; // never throw in the UI
            return;
        }
        CancelRestore();
    }

    private void CancelRestore()
    {
        ResetImport();
        _importInputKey++; // force a fresh <InputFile> so the old selection is gone
    }

    /// <summary>Clears the whole import state (but not the InputFile reset key).</summary>
    private void ResetImport()
    {
        _importJson = string.Empty;
        _importFileName = string.Empty;
        _importFormat = null;
        _importSummary = null;
        _backupPasswordChecked = false;
        _backupPassword = string.Empty;
        _pendingRestore = false;
        _importError = null;
        _importQueries = [];
    }
}
