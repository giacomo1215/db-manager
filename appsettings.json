{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStore": {
    "Path": "~/.db-manager/connections.json"
  },
  "QueryStore": {
    "Path": "~/.db-manager/queries.db"
  },
  "Settings": {
    "Path": "~/.db-manager/settings.json"
  },
  "SqlEditor": {
    "CommandTimeoutSeconds": 60,
    "DumpCommandTimeoutSeconds": 0
  }
}