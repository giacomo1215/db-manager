<Project>
  <PropertyGroup>
    <DbManagerMode>Server</DbManagerMode>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Not single-file: a single-file exe redirects AppContext.BaseDirectory
         to a random extraction dir, which breaks MapStaticAssets' on-disk
         manifest. A folder also keeps appsettings.json editable for LAN
         https/Kestrel configuration. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>.\publish\server\win-x64\</PublishDir>
  </PropertyGroup>
</Project>